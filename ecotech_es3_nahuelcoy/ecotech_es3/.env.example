# Copie este archivo como ".env" y ajuste los valores locales.
# El archivo .env NUNCA se sube a Git (está en .gitignore).

ECOTECH_DB_PATH=datos/ecotech.db

# APIs externas oficiales (sin clave obligatoria; configurables por entorno)
API_CLIMA_URL=https://api.open-meteo.com/v1/forecast
API_DIVISAS_URL=https://mindicador.cl/api

# Parámetros de resiliencia del cliente HTTP
API_TIMEOUT_CONEXION=3.0
API_TIMEOUT_LECTURA=7.0
API_MAX_INTENTOS=3
API_BACKOFF_BASE=1.0
